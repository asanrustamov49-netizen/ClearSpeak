# OmniRoute — OpenAI-compatible AI gateway (https://github.com/diegosouzapw/OmniRoute)
# Base URL including the /v1 prefix. Default local install listens on port 20128.
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# API key from OmniRoute Dashboard -> Endpoints. Server-side only, never exposed to the browser.
# Leave empty only if your OmniRoute instance accepts unauthenticated requests.
OMNIROUTE_API_KEY=your-omniroute-api-key

# Main conversational model ("provider/model" as listed by GET /v1/models, or a combo such as "auto").
# Pick a model that supports response_format json_schema. Measured example: grok-cli/grok-4.7
OMNIROUTE_MODEL=auto

# Optional: sent as reasoning_effort (none | minimal | low | medium | high). Leave empty to use the model default.
# Hidden reasoning tokens were the main source of latency; "low" kept answers valid and cut response time ~3x.
OMNIROUTE_REASONING_EFFORT=low

# Optional: fast, cheap model for tap-to-translate and hints. Defaults to OMNIROUTE_MODEL.
OMNIROUTE_FAST_MODEL=

# Optional: verified backup used ONLY when the main model times out or returns 5xx (never on 401/402/429).
OMNIROUTE_FALLBACK_MODEL=

# Optional: image generation via POST /v1/images/generations (provider must be connected in OmniRoute
# and appear in its image registry). Example verified locally: antigravity/gemini-3.1-flash-image
OMNIROUTE_IMAGE_MODEL=

# Optional: vision model that describes the generated image once (chat with image_url input + json_schema).
# Required for "Start Conversation About This Image". Example verified locally: gemini/gemini-3.1-flash-lite
OMNIROUTE_VISION_MODEL=

# Optional: natural voice through OmniRoute POST /v1/audio/speech (used when CARTESIA_API_KEY is empty).
# Verified: elevenlabs/eleven_turbo_v2_5 with a DEFAULT ElevenLabs voice id. On the free ElevenLabs plan,
# Voice Library voices (incl. OpenAI names like "alloy" -> Rachel) return 402.
OMNIROUTE_TTS_MODEL=
OMNIROUTE_TTS_VOICE=

# --- Optional: Cartesia TTS (natural AI voice). Takes priority over OmniRoute TTS; otherwise browser speechSynthesis. ---
# API key from https://play.cartesia.ai/keys (starts with sk_car_). Server-side only.
CARTESIA_API_KEY=
# Voice ID from the Cartesia voice library (play.cartesia.ai) or GET https://api.cartesia.ai/voices?language=en
# If empty, the server picks the first English voice returned by the Voices API.
CARTESIA_VOICE_ID=
# Model: sonic-3 (default), sonic-3.5, sonic-3.6 or sonic-latest.
CARTESIA_MODEL_ID=sonic-3
